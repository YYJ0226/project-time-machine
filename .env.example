# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server only. Optional locally, recommended for evidence sync to avoid
# GitHub's low unauthenticated API rate limit. Never prefix with NEXT_PUBLIC_.
GITHUB_TOKEN=

# Server only. Never commit a real key or prefix it with NEXT_PUBLIC_.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Production only: exact canonical HTTPS origin, with no path or query.
# Required for safe OAuth callback redirects. Keep unset for localhost development.
# APP_ORIGIN=https://your-project.vercel.app
# Required in production when AI is enabled. Exact GitHub logins, comma-separated.
# AI_ALLOWED_GITHUB_USERS=your-github-login

# Optional database regression check only, NOT needed by the web app.
# Copy host/user from your Supabase Connect -> Session pooler panel.
# SUPABASE_DB_HOST=
# SUPABASE_DB_USER=postgres.<project-ref>
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_CA_FILE=C:/path/to/prod-ca-2021.crt

# Optional, server only. Set this when Node cannot reach Supabase/GitHub directly.
# Use your own local HTTP proxy address, then restart the dev server.
# HTTPS_PROXY=http://127.0.0.1:<port>
# NO_PROXY=localhost,127.0.0.1,::1
