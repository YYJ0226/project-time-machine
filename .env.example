# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server only. Optional locally, recommended for evidence sync to avoid
# GitHub's low unauthenticated API rate limit. Never prefix with NEXT_PUBLIC_.
GITHUB_TOKEN=

# Optional, server only. Set this when Node cannot reach Supabase/GitHub directly.
# Use your own local HTTP proxy address, then restart the dev server.
# HTTPS_PROXY=http://127.0.0.1:<port>
# NO_PROXY=localhost,127.0.0.1,::1
